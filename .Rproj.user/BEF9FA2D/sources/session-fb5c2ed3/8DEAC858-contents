#더보기 : 1개월 데이터 수집하려면 여기는 2만개정도의 게시글이 올라오니 1000개로 설정 

n <- 500 ############설정하기 = 전체게시글수/20 -> 전체글 긁어오기가능###########

#i=1

for(i in 1:n){
  tryCatch({
    print(i)
    
    body <- remDr$getPageSource()[[1]]
    body <- body %>% read_html()
    
    more_reply <- remDr$findElement("css", "span.u_cbox_page_more")
    more_reply$clickElement()
    
    if(i==n) break()
    
    Sys.sleep(time = 0.02)
    
  }, error = function(e) cat("불러올 수 없습니다!\n"))
  
}

Sys.sleep(time = 0.3)


