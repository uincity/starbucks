##링크

link <- body %>% 
  html_nodes("ul.list_area") %>%
  html_nodes("li.board_box") %>%
  html_nodes("a.txt_area") %>%
  html_attr("href")

Sys.sleep(time = 0.3)



##제목

title <- body %>% 
  html_nodes("a.txt_area") %>%
  html_nodes("strong.tit") %>%
  html_text()  

Sys.sleep(time = 0.3)


##날짜

wdate <- body %>% 
  html_nodes("span.time") %>%
  html_text()  

Sys.sleep(time = 0.3)


##조회수

s_count <- body %>% 
  html_nodes("span.no") %>%
  html_text()  

s_count <- str_replace_all(s_count,"조회 ", "")
s_count <- str_replace_all(s_count,",", "")

Sys.sleep(time = 0.3)


##작성자

nickname <- body %>% 
  html_nodes("span.nick") %>%
  html_nodes("span.ellip") %>%
  html_text()  

Sys.sleep(time = 0.3)


##댓글수

r_count <- body %>% 
  html_nodes("em.num") %>%
  html_text()  

Sys.sleep(time = 0.3)


