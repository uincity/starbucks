library(httr)
library(jsonlite)
# 변환할 도로명 주소
road_address <- "서울특별시 강남구 역삼동 123-45"
# 카카오 주소 검색 API 사용 예시
api_key <- "eeef2a60013e6941cf9918810f40fe63"
# 변환할 도로명 주소
road_address <- "서울특별시 서초구 서초중앙로 225"
# 카카오 주소 검색 API 사용 예시
api_key <- "eeef2a60013e6941cf9918810f40fe63"
kakao_url <- paste0("https://dapi.kakao.com/v2/local/search/address.json?query=", URLencode(road_address))
kakao_headers <- c("Authorization" = paste("KakaoAK", api_key))
response <- GET(kakao_url, add_headers(.headers = kakao_headers))
parsed_data <- content(response, as = "text", encoding = "UTF-8")
parsed_json <- fromJSON(parsed_data, flatten = TRUE)
# 카카오 주소 검색 API 결과 출력 (지번 주소)
jibun_address <- parsed_json$documents$address_name
print(jibun_address)
kakao_url
kakao_headers
GET(kakao_url, add_headers(.headers = kakao_headers))
response
content(response, as = "text", encoding = "UTF-8")
URLencode(road_address)
kakao_headers <- c("Authorization: " = paste("KakaoAK", api_key))
kakao_headers
